+@pytest.mark.parametrize("application_id,task_id", [("a", "z"), ("z", "a")])
+@pytest.mark.parametrize("due,partition", [(None, "undated_personal"), ("2026-10-11", "overdue_personal"), ("2026-10-12", "today_personal"), ("2026-10-13", "future")])
+def test_today_combined_personal_record_ids_are_stable_across_entity_types(application_id, task_id, due, partition):
+    entered_details = details(due)
+    first = d.apply_action(None, request("create_application", target=target(), label="Entered A", details=entered_details), context(1, new_application_id=application_id, target=observation()))
+    second = d.apply_action(first.state, request("create_personal_task", 1, 2, application_id=application_id, personal=personal(details=entered_details)), context(2, new_task_id=task_id))
+    result = d.project_today(today_input(second.state))
+    cards = getattr(result, partition)
+    assert [card.target.id for card in cards] == ["a", "z"]
+    assert {card.target.kind for card in cards} == {"application", "document_task"}
+    assert all(card.planned_minutes is None for card in cards)
+
+
+def test_today_future_preserves_study_before_stable_personal_actions_on_equal_dates():
+    first = d.apply_action(None, request("create_application", target=target(), label="Entered A", details=details("2026-10-13")), context(1, new_application_id="a", target=observation()))
+    second = d.apply_action(first.state, request("create_personal_task", 1, 2, application_id="a", personal=personal(details=details("2026-10-13"))), context(2, new_task_id="z"))
+    plan = active_plan(actions=[study("study-z", "2026-10-13"), study("study-a", "2026-10-13")])
+    result = d.project_today(today_input(second.state, plan=plan))
+    assert [card.id for card in result.future] == ["study-z", "study-a", "application:a", "document:z"]
+    assert result.allocated_study_minutes == 40
