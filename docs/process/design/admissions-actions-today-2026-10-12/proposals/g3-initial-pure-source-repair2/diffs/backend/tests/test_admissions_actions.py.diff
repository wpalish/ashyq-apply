+def test_personal_creation_rehashed_receipt_cannot_inject_an_earlier_reviewed_source_binding():
+    bound = binding_after(application())
+    accepted = d.apply_action(bound.state, request("create_personal_task", 2, 3, application_id=None, personal=personal()), context(3))
+    original = accepted.receipt.model_dump(mode="json")
+    assert d.replay_receipt(PROFILE, bound.receipt.request, bound.receipt) == bound.receipt
+    assert d.replay_receipt(PROFILE, accepted.receipt.request, accepted.receipt) == accepted.receipt
+    forged = copy.deepcopy(original)
+    earlier = bound.state.document_tasks[0].model_dump(mode="json")
+    created = forged["applied_delta"]["document_tasks"][0]
+    created.update(binding=earlier["binding"], binding_ref=earlier["binding_ref"], origin="source_reference")
+    # This copied old binding is otherwise a structurally valid own task; the
+    # rejected shape is the personal-command-to-delta semantic contradiction.
+    assert s.DocumentTaskV1.model_validate_json(json.dumps(created)).binding is not None
+    unsigned = {key: value for key, value in forged.items() if key != "receipt_digest"}
+    forged["receipt_digest"] = hashlib.sha256(json.dumps({"schema_version": "g3-action-receipt-digest-v1", "receipt": unsigned}, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode()).hexdigest()
+    safe_error("saved_unreadable", lambda: d.replay_receipt(PROFILE, accepted.receipt.request, forged))
+    assert accepted.receipt.model_dump(mode="json") == original
