              <source srcset="/sites/default/files/styles/1_6_567w_354h_n/public/2019-11/main-kokoon.jpg?h=d10b028a&amp;itok=Jk9lzWxQ 567w, /sites/default/files/styles/1_6_819w_512h_n/public/2019-11/main-kokoon.jpg?h=d10b028a&amp;itok=fL_OgZGZ 819w" media="all and (max-width: 991px)" type="image/jpeg" sizes="(min-width: 740px) calc(100vw - 80px), (min-width: 320px) calc(100vw - 32px), 288px" width="819" height="512"/>
                  <img loading="eager" width="567" height="354" data-original-width="5472" data-original-height="3648" src="/sites/default/files/styles/1_6_567w_354h_n/public/2019-11/main-kokoon.jpg?h=d10b028a&amp;itok=Jk9lzWxQ" alt="One module of the Kokoon living unit being moved by crane, Wood Program, Photos: Anne Kinnune, Tuomas Uusheimo, Marc Goodwin, Juho Haavisto" />

