":false,"advanced_settings":""},"cookiebot":{"message_placeholder_cookieconsent_optout_marketing_show":false,"message_placeholder_cookieconsent_optout_marketing":"\u003Cdiv class=\u0022cookiebot cookieconsent-optout-marketing\u0022\u003E\n\t\u003Cdiv class=\u0022cookieconsent-optout-marketing__inner\u0022\u003E\n\t\t\u003Cdiv class=\u0022aalto-user-generated-content\u0022\u003E\n\u003Cp\u003EPlease \u003Ca href=\u0022!cookiebot_renew\u0022\u003Eaccept marketing-cookies\u003C\/a\u003E to view this embedded content from \u003Ca href=\u0022!cookiebot_from_src_url\u0022\u003E!cookiebot_from_src_url\u003C\/a\u003E\u003C\/p\u003E\n\u003C\/div\u003E\n\n\t\u003C\/div\u003E\n\u003C\/div\u003E\n"},"languageSwitcher":{"modalContent":{"fi":"\u003Ch2\u003EIk\u00e4v\u00e4 kyll\u00e4 etsim\u00e4\u00e4si sivua ei ole k\u00e4\u00e4nnetty suomeksi.\u003C\/h2\u003E\u003Cp\u003ET\u00e4ll\u00e4 sivulla on seuraavat kieliversiot: \u003Ca href=\u0022\/en\/wood-program\/kokoon-project-information\u0022 hreflang=\u0022en\u0022\u003Eenglanti\u003C\/a\u003E.\u003C\/p\u003E\u003Cp\u003E\u003Ca href=\u0022\/fi\u0022\u003EPalaa aalto.fi-etusivulle\u003C\/a\u003E\u003C\/p\u003E\u003Ch3\u003EMiksi n\u00e4in tapahtuu?\u003C\/h3\u003E\u003Cp\u003EJulkaisemme aalto.fi-sivustolla p\u00e4ivitt\u00e4in valtavasti sis\u00e4lt\u00f6\u00e4 suomeksi, ruotsiksi ja englanniksi. Osa sivuista on kuitenkin julkaistu vain yhdell\u00e4 tai kahdella kielell\u00e4. Pahoittelut - pyrimme jatkossa viel\u00e4 parempaan.\u003C\/p\u003E","sv":"\u003Ch2\u003ETyv\u00e4rr har sidan inte \u00f6versatts till svenska\u003C\/h2\u003E\u003Cp\u003ESidan finns p\u00e5 f\u00f6ljande spr\u00e5k: \u003Ca href=\u0022\/en\/wood-program\/kokoon-project-information\u0022 hreflang=\u0022en\u0022\u003Eengelska\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003E\u003Ca href=\u0022\/sv\u0022\u003EG\u00e5 till aalto.fi-framsidan\u003C\/a\u003E\u003C\/p\u003E\u003Ch3\u003EVarf\u00f6r h\u00e4nder detta?\u003C\/h3\u003E\u003Cp\u003EVi skapar en stor m\u00e4ngd inneh\u00e5ll dagligen till aalto.fi p\u00e5 b\u00e5de finska, engelska och svenska. En del inneh\u00e5ll kommer tyv\u00e4rr bara att vara tillg\u00e4ngligt p\u00e5 ett eller tv\u00e5 spr\u00e5k. Vi ber om urs\u00e4kt f\u00f6r besv\u00e4ret och \u00e4r tacksamma f\u00f6r er f\u00f6rst\u00e5else.\u003C\/p\u003E"}},"gallery_styles":{"123316":["https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_567w_ah_n_nu\/public\/2019-11\/tuomasuusheimo-160915-kokoon-027.jpg?itok=dFOL07uh","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_819w_ah_n_nu\/public\/2019-11\/tuomasuusheimo-160915-kokoon-027.jpg?itok=tQm0g3-w","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_914w_ah_n_nu\/public\/2019-11\/tuomasuusheimo-160915-kokoon-027.jpg?itok=WCQPeI3C","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_1074w_ah_n_nu\/public\/2019-11\/tuomasuusheimo-160915-kokoon-027.jpg?itok=QP_kAQg-","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_1800w_ah_n_nu\/public\/2019-11\/tuomasuusheimo-160915-kokoon-027.jpg?itok=nyamjc92"],"123311":["https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_567w_ah_n_nu\/public\/2019-11\/philiptidwell_3.jpg?itok=8vqyLtcX","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_819w_ah_n_nu\/public\/2019-11\/philiptidwell_3.jpg?itok=zXX3h3ev","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_914w_ah_n_nu\/public\/2019-11\/philiptidwell_3.jpg?itok=yAfKeGsW","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_1074w_ah_n_nu\/public\/2019-11\/philiptidwell_3.jpg?itok=xxD7w8Yc","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_1800w_ah_n_nu\/public\/2019-11\/philiptidwell_3.jpg?itok=VsW5Hxgj"],"123301":["https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_567w_ah_n_nu\/public\/2019-11\/kokoon.png?itok=mr15PQlB","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_819w_ah_n_nu\/public\/2019-11\/kokoon.png?itok=HGlHpWpa","https:\/\/www.aalto.fi\/sites\/default\/files\/styles\/o_914w_ah_n_n