              <source srcset="/sites/default/files/styles/1_464w_464h_d/public/2026-04/Aalto_University_School_of_Science_09-04-2026_PHOTO_Matti_Ahlgren-52.jpg?h=c3635fa2&amp;itok=lio7xBBt 464w, /sites/default/files/styles/1_684w_684h_d/public/2026-04/Aalto_University_School_of_Science_09-04-2026_PHOTO_Matti_Ahlgren-52.jpg?itok=yDuj_B0w 684w, /sites/default/files/styles/1_798w_798h_d/public/2026-04/Aalto_University_School_of_Science_09-04-2026_PHOTO_Matti_Ahlgren-52.jpg?itok=mEzRToA0 798w, /sites/default/files/styles/1_1064w_1064h_d/public/2026-04/Aalto_University_School_of_Science_09-04-2026_PHOTO_Matti_Ahlgren-52.jpg?itok=XcQ0GWHO 1064w" media="all and (max-width: 991px)" type="image/jpeg" sizes="(min-width: 745px) calc((100vw - 40px - 40px) / 2), (min-width: 320px) calc(100vw - 16px - 16px), 320px" width="798" height="798"/>
