                        <picture>
                  <source srcset="/sites/default/files/styles/1_304w_304h_d/public/2024-03/Sammalkorven.png?h=1e66e246&amp;itok=_Vim_cLU 304w, /sites/default/files/styles/1_464w_464h_d/public/2024-03/Sammalkorven.png?h=1e66e246&amp;itok=pV-1CYIX 464w" media="all" type="image/png" sizes="(min-width: 1200px) 464px, (min-width: 600px) 304px, 288px" width="464" height="464"/>
