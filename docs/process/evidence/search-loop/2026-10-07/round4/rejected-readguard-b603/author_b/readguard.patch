+    def _reserve_university_read(self) -> None:
+        self._check_cancelled()
+        key = read_budget.ACTIVE_UNIVERSITY.get()
+        if key is None:
+            raise UniversityReadStopped("missing_university_scope")
+        self._change_read_budget(key, reserve=True)
