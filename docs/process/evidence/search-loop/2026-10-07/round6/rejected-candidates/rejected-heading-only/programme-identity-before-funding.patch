+def _programme_content_identity(
+    identity: str, title: str, path: str, body: str, headings: list[str]
+) -> bool:
+    """A single programme with its own academic content, not merely a support label."""
+    primary = f"{title} {identity}"
+    if _SCHOLARSHIP_WORD.search(primary) or _award_name(identity):
+        return False
+    subject = _program_name(identity) or _program_name_from_context(
+        identity, title, path, body[:4000]
+    )
+    if not subject:
+        return False
+    # Secondary funding can also be the main purpose of a generically headed
+    # support page. Restrict the bypass to an explicit academic-content block;
+    # title/degree words alone would promote "Undergraduate support".
+    return any(
+        re.fullmatch(
+            r"curriculum|(?:course|programme|program|degree) structure|"
+            r"(?:course|programme|program) content|what you (?:will )?(?:learn|study)",
+            heading.strip(),
+            re.IGNORECASE,
+        )
+        for heading in headings
+    )
