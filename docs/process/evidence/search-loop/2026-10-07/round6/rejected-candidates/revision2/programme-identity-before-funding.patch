+_ACADEMIC_HEADING = re.compile(
+    r"curriculum|(?:course|programme|program|degree) structure|"
+    r"(?:course|programme|program) content|what you (?:will )?(?:learn|study)",
+    re.IGNORECASE,
+)
+_ACADEMIC_UNIT = re.compile(r"\b(courses?|modules?|subjects?|lectures?|projects?)\b", re.I)
+_YEAR_STAGE = re.compile(
+    r"\b(first|second|third|fourth|fifth|sixth|[1-6](?:st|nd|rd|th)?)[- ]year\b"
+    r"|\byear\s+([1-6])\b",
+    re.I,
+)
+_NO_DEGREE_OFFER = re.compile(
+    r"\b(?:this (?:support )?page|we)\b[^.]{0,100}\b(?:does?|do) not offer\s+"
+    r"(?:(?:a|an|any|the|this)\s+)?"
+    r"(?:(?:bachelor'?s?|master'?s?|undergraduate|postgraduate|academic)\s+)?"
+    r"(?:degree(?: programme| program)?|programme|program)\b"
+    r"|\bno degree(?: programme| program)? (?:is )?offered\b",
+    re.I,
+)
+_ACADEMIC_ELIGIBILITY = re.compile(
+    r"\b(?:applicants?|eligibility|eligible|qualify|renewal|renewing)\b", re.I
+)
+
+
+def _academic_chrome(node: Tag) -> bool:
+    return (
+        node.name in {"nav", "aside", "header", "footer"}
+        or str(node.get("role", "")).lower()
+        in {"navigation", "banner", "complementary", "contentinfo"}
+        or str(node.get("aria-hidden", "")).lower() == "true"
+        or node.has_attr("hidden")
+    )
+
+
+def _academic_heading_rank(node: Tag) -> int | None:
+    if re.fullmatch(r"h[1-6]", node.name or ""):
+        return int(node.name[1])
+    if str(node.get("role", "")).lower() == "heading":
+        level = str(node.get("aria-level", ""))
+        return int(level) if level in {"1", "2", "3", "4", "5", "6"} else None
+    return None
+
+
+def _academic_section_text(heading: Tag, soup: BeautifulSoup) -> str:
+    """Close at the containing semantic section/region and equal or higher heading."""
+    rank = _academic_heading_rank(heading)
+    root = soup
+    for parent in heading.parents:
+        if parent is soup:
+            break
+        if parent.name in {"section", "article"} or str(parent.get("role", "")).lower() == "region":
+            root = parent
+            break
+    parts: list[str] = []
+    for node in heading.next_elements:
+        parents = list(node.parents)
+        if not any(parent is root for parent in parents):
+            break
+        if any(parent is heading for parent in parents):
+            continue
+        if (isinstance(node, Tag) and _academic_chrome(node)) or any(
+            _academic_chrome(parent) for parent in parents
+        ):
+            continue
+        if isinstance(node, Tag):
+            next_rank = _academic_heading_rank(node)
+            if next_rank is not None and rank is not None and next_rank <= rank:
+                break
+        if isinstance(node, NavigableString) and not isinstance(node, Comment) and node.strip():
+            parts.append(str(node).strip())
+    return " ".join(parts)
+
+
+def _programme_content_identity(
+    identity: str, title: str, path: str, body: str, soup: BeautifulSoup | None
+) -> bool:
+    """Require a programme identity and academic structure in the same content block."""
+    primary = f"{title} {identity}"
+    if _SCHOLARSHIP_WORD.search(primary) or _award_name(identity):
+        return False
+    if _ADMISSIONS.search(identity) or re.search(r"\bsupport\b", identity, re.I):
+        return False
+    if _NO_DEGREE_OFFER.search(body) or soup is None:
+        return False
+    if re.search(
+        r"\bthis page\b[^.]{0,40}\b(?:lists?|provides?|offers?)\b"
+        r"[^.]{0,60}\b(?:scholarships?|funding|financial aid|bursaries)\b",
+        body[:2000],
+        re.I,
+    ):
+        return False
+    if re.search(
+        r"\bthis (?:page is|is)\s+(?:(?:a|an|the)\s+)?"
+        r"(?:funding|scholarship|financial (?:aid|support)|bursary)"
+        r"(?:\s+\w+){0,4}\s+page\b",
+        body[:2000],
+        re.I,
+    ):
+        return False
+    subject = _program_name(identity) or _program_name_from_context(
+        identity, title, path, body[:4000]
+    )
+    if not subject:
+        return False
+    for heading in soup.find_all(re.compile(r"^h[1-6]$")):
+        if not _ACADEMIC_HEADING.fullmatch(heading.get_text(" ", strip=True)):
+            continue
+        if _academic_chrome(heading) or any(_academic_chrome(parent) for parent in heading.parents):
+            continue
+        block = _academic_section_text(heading, soup)
+        # A scholarship curriculum/eligibility section is not the degree's
+        # academic structure. Secondary funding outside this block is harmless.
+        if (
+            _SCHOLARSHIP_WORD.search(block)
+            or _ACADEMIC_ELIGIBILITY.search(block)
+            or not _ACADEMIC_UNIT.search(block)
+        ):
+            continue
+        stages = set()
+        ordinals = {
+            "first": "1",
+            "second": "2",
+            "third": "3",
+            "fourth": "4",
+            "fifth": "5",
+            "sixth": "6",
+        }
+        for match in _YEAR_STAGE.finditer(block):
+            stage = match.group(1) or match.group(2)
+            stages.add(ordinals.get(stage.lower(), stage[0]))
+        if len(stages) >= 2 or re.search(
+            r"\b\d+(?:\.\d+)?\s*(?:ECTS|credits?|units?)\b", block, re.I
+        ):
+            return True
+    return False
+
+
