</tr>
<tr>
<td>Neural Networks and Language Models (10&nbsp;EC)</td><td colspan="2"><span class="active"></span></td><td></td><td></td>
</tr>
<tr>
<td>Information Theory (5&nbsp;EC)</td><td></td><td><span class="active"></span></td><td></td><td></td>
</tr>
<tr>
<td>Usability and UX Ontwerp (5&nbsp;EC)</td><td></td><td></td><td><span class="active"></span></td><td></td>
</tr>
<tr>
<td><span lang="nl">Humane AI in Digital Societies: Projects</span> (10&nbsp;EC)</td><td></td><td></td><td colspan="2"><span class="active"></span></td>
</tr>
<tr>
<td>Speech and Language Processing (10&nbsp;EC)</td><td></td><td></td><td colspan="2"><span class="active"></span></td>
</tr>
<tr>
<td>Human-Robot Interaction (5&nbsp;EC)</td><td></td><td></td><td></td><td><span class="active"></span></td>
</tr>
