<li data-level="1" data-compare-nr="1" class="rug-media rug-mb js--equal">
<div class="rug-media__img">
<a aria-label="12 Essentials in My Uni Bag" href="/education/student-blog/12-essentials-in-my-uni-bag">
<div class="rug-image--placeholder" style="width:105px;height:140px;overflow:hidden;">
<img alt="" data-height="140" data-width="105" class="js--resize" src="/education/student-blog/12-essentials-in-my-uni-bag!attachment?c=images/blog-image-normal.jpg"></div>
