+def run_owned_process(
+    command, *, cwd, input=None, env=None, timeout, text=False, capture_output=True, check=False
+):
+    """Kill the owned group and bound cleanup; preserve the original control."""
+    if not capture_output or check:
+        raise ValueError("Owned process requires original captured streams")
+    process = subprocess.Popen(
+        command,
+        cwd=cwd,
+        env=env,
+        stdin=subprocess.PIPE if input is not None else None,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=text,
+        start_new_session=True,
+    )
+    try:
+        stdout, stderr = process.communicate(input=input, timeout=timeout)
+    except BaseException as exc:
+        cleanup_deadline = time.monotonic() + 1.0
+        cleanup_incomplete = False
+        with suppress(OSError):
+            os.killpg(process.pid, signal.SIGKILL)
+        try:
+            stdout, stderr = process.communicate(
+                timeout=max(0.001, cleanup_deadline - time.monotonic())
+            )
+            if isinstance(exc, subprocess.TimeoutExpired):
+                exc.output, exc.stderr = stdout, stderr
+        except subprocess.TimeoutExpired as drain:
+            cleanup_incomplete = True
+            if isinstance(exc, subprocess.TimeoutExpired):
+                if drain.output is not None:
+                    exc.output = drain.output
+                if drain.stderr is not None:
+                    exc.stderr = drain.stderr
+        except OSError:
+            cleanup_incomplete = True
+        finally:
+            for stream in (process.stdin, process.stdout, process.stderr):
+                if stream is not None:
+                    with suppress(OSError):
+                        stream.close()
+            try:
+                process.wait(timeout=max(0.001, cleanup_deadline - time.monotonic()))
+            except (subprocess.TimeoutExpired, OSError):
+                cleanup_incomplete = True
+            # A timeout/cancel remains the original exception even if an escaped
+            # descendant holds a pipe or owned-process reaping cannot complete.
+            exc.__dict__["cleanup_incomplete"] = cleanup_incomplete
+        raise
+    return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)
