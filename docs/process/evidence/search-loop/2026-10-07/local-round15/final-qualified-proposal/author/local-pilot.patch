+def test_owned_process_timeout_kills_own_group(monkeypatch):
+    calls = []
+    for stuck, original in (
+        (False, subprocess.TimeoutExpired("synthetic", 1, output="initial")),
+        (True, subprocess.TimeoutExpired("synthetic", 1, output="initial")),
+        (True, RuntimeError("original control")),
+    ):
+
+        class Process:
+            pid = 424242
+            returncode = None
+            stdin = stdout = stderr = None
+            attempts = 0
+
+            def communicate(self, *, _original=original, _stuck=stuck, **kwargs):
+                self.attempts += 1
+                assert 0 < kwargs["timeout"] <= 1
+                if self.attempts == 1:
+                    raise _original
+                calls.append("drain")
+                if _stuck:
+                    raise subprocess.TimeoutExpired(
+                        "synthetic", 1, output="partial stdout", stderr="partial stderr"
+                    )
+                return "drained stdout", "drained stderr"
+
+            def wait(self, *, timeout, _stuck=stuck):
+                assert 0 < timeout <= 1
+                calls.append("wait")
+                if _stuck:
+                    raise subprocess.TimeoutExpired("synthetic", timeout)
+                return -9
+
+        monkeypatch.setattr(
+            s.subprocess,
+            "Popen",
+            lambda *_a, **k: (calls.append(k["start_new_session"]) or Process()),
+        )
+        monkeypatch.setattr(s.os, "killpg", lambda pid, signal: calls.append((pid, signal)))
+        with pytest.raises(type(original)) as stopped:
+            s.run_owned_process(["synthetic"], cwd=Path("/synthetic"), timeout=1)
+        assert stopped.value is original and original.cleanup_incomplete is stuck
+        if isinstance(original, subprocess.TimeoutExpired):
+            assert original.stdout == ("partial stdout" if stuck else "drained stdout")
+            assert original.stderr == ("partial stderr" if stuck else "drained stderr")
+        assert calls[-4] is True and calls[-3][0] == 424242 and calls[-1] == "wait"
+
