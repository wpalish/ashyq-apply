+        )
+        (case.root / "busy-proof.json").write_text(json.dumps(report, indent=2))
+        assert len(case.transport) == 36
+    finally:
+        for b in blockers:
+            b.rollback()
+            b.close()
+    assert case.state()["status"] == "running" and case.state()["completed"] == 0
