(version 1)
(allow default)
(deny network*)
(allow network-inbound
    (local tcp "localhost:5243")
    (local tcp "localhost:8153"))
(allow network-outbound
    (remote tcp "localhost:5243")
    (remote tcp "localhost:8153"))
; Native Chromium uses local UNIX-domain IPC. This grants no IP egress.
(allow network*
    (local unix-socket (subpath "/"))
    (remote unix-socket (subpath "/")))
