+def _compatible_with_label(claim: ClaimOut, label: str) -> bool:
+    allowed = _LEGACY_EXAM_TYPES.get(label)
+    if allowed is not None and claim.claim_type not in allowed:
+        return False
+    component = label.removeprefix("ielts ")
+    if component in _IELTS_COMPONENTS and isinstance(claim.normalized_value, dict):
+        # A band-specific record cannot support a different band. A scalar
+        # subscore claim retains eligibility.py's explicit all-band semantics.
+        return component in {str(key).casefold() for key in claim.normalized_value}
+    return True
+
+
+def _referenced_claims(
+    check: RequirementCheck, claims: list[ClaimOut], label: str
+) -> tuple[list[ClaimOut], set[str]]:
+    exact = [
+        claim
+        for claim in claims
+        if claim.id in check.claim_ids
+        and claim.claim_type in EXAM_CLAIM_TYPES
+        and _compatible_with_label(claim, label)
+    ]
+    chosen: set[str] = set()
+    matched: set[str] = set()
+    for reference in check.claim_ids:
+        ids = [claim for claim in claims if claim.id == reference]
+        if ids:
+            candidates = [claim for claim in exact if claim.id == reference]
+        else:
+            # When an exact ID and its URL are both recorded, the URL adds
+            # provenance for that claim; it does not select its page neighbours.
+            candidates = [claim for claim in exact if claim.source_url == reference]
+            if not candidates and label in _LEGACY_EXAM_TYPES:
+                candidates = [
+                    claim
+                    for claim in claims
+                    if claim.source_url == reference
+                    and claim.claim_type in _LEGACY_EXAM_TYPES[label]
+                    and _compatible_with_label(claim, label)
+                ]
+                if len(candidates) != 1:
+                    # A shared URL cannot choose between two otherwise compatible
+                    # records. Keep the original check visible but unresolved.
+                    candidates = []
+        if candidates:
+            matched.add(reference)
+            chosen.update(claim.id for claim in candidates)
+    return [claim for claim in claims if claim.id in chosen], matched
 
 
