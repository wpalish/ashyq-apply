+def test_legacy_family_filter_does_not_remove_scope_stale_or_conflict_controls(mode, expected):
+    updates = {
+        "scope": {
+            "scope": ClaimScope(
+                university="Other", programme="BSc", degree="bachelor", intake="fall 2027"
