+# These labels are emitted by eligibility.py (plus the existing named SAT skill links).
+# A page URL identifies a document, not a particular requirement on that document.
+_LEGACY_EXAM_TYPES: dict[str, frozenset[ClaimType]] = {
+    "sat total": frozenset({ClaimType.SAT_MIN_TOTAL}),
+    "sat math": frozenset({ClaimType.SAT_MIN_TOTAL}),
+    "sat mathematics": frozenset({ClaimType.SAT_MIN_TOTAL}),
+    "sat reading and writing": frozenset({ClaimType.SAT_MIN_TOTAL}),
+    "sat reading/writing": frozenset({ClaimType.SAT_MIN_TOTAL}),
+    "sat reading_writing": frozenset({ClaimType.SAT_MIN_TOTAL}),
+    "sat policy": frozenset({ClaimType.SAT_POLICY}),
+    "accepted ielts test type": frozenset({ClaimType.IELTS_ACCEPTED_TYPES}),
+    "english test waiver": frozenset({ClaimType.ENGLISH_TEST_WAIVER}),
+    "ielts overall": frozenset({ClaimType.IELTS_MIN_OVERALL}),
+    "ielts listening": frozenset({ClaimType.IELTS_MIN_SUBSCORE}),
+    "ielts reading": frozenset({ClaimType.IELTS_MIN_SUBSCORE}),
+    "ielts writing": frozenset({ClaimType.IELTS_MIN_SUBSCORE}),
+    "ielts speaking": frozenset({ClaimType.IELTS_MIN_SUBSCORE}),
+    "toefl total": frozenset({ClaimType.TOEFL_MIN_TOTAL}),
+    "entrance examination": frozenset({ClaimType.ENTRANCE_EXAM_REQUIRED}),
+}
+_NON_EXAM_LABELS = frozenset(
+    {
+        "intake accepting applications",
+        "admission deadline",
+        "minimum gpa",
+        "portfolio",
+        "interview",
+        "credential evaluation",
+        "required subjects",
+        "academic entry requirements",
+    }
+)
+_IELTS_COMPONENTS = frozenset({"listening", "reading", "writing", "speaking"})
+
+
+def _compatible_with_label(claim: ClaimOut, label: str) -> bool:
+    allowed = _LEGACY_EXAM_TYPES.get(label)
+    if allowed is not None and claim.claim_type not in allowed:
+        return False
+    component = label.removeprefix("ielts ")
+    if component in _IELTS_COMPONENTS and isinstance(claim.normalized_value, dict):
+        # A band-specific record cannot support a different band. A scalar
+        # subscore claim retains eligibility.py's explicit all-band semantics.
+        return component in {str(key).casefold() for key in claim.normalized_value}
+    return True
+
+
+def _referenced_claims(
+    check: RequirementCheck, claims: list[ClaimOut], label: str
+) -> tuple[list[ClaimOut], set[str]]:
+    exact = [
+        claim
+        for claim in claims
+        if claim.id in check.claim_ids
+        and claim.claim_type in EXAM_CLAIM_TYPES
+        and _compatible_with_label(claim, label)
+    ]
+    chosen: set[str] = set()
+    matched: set[str] = set()
+    for reference in check.claim_ids:
+        ids = [claim for claim in claims if claim.id == reference]
+        if ids:
+            candidates = [claim for claim in exact if claim.id == reference]
+        else:
+            # When an exact ID and its URL are both recorded, the URL adds
+            # provenance for that claim; it does not select its page neighbours.
+            candidates = [claim for claim in exact if claim.source_url == reference]
+            if not candidates and label in _LEGACY_EXAM_TYPES:
+                candidates = [
+                    claim
+                    for claim in claims
+                    if claim.source_url == reference
+                    and claim.claim_type in _LEGACY_EXAM_TYPES[label]
+                    and _compatible_with_label(claim, label)
+                ]
+                if len(candidates) != 1:
+                    # A shared URL cannot choose between two otherwise compatible
+                    # records. Keep the original check visible but unresolved.
+                    candidates = []
+        if candidates:
+            matched.add(reference)
+            chosen.update(claim.id for claim in candidates)
+    return [claim for claim in claims if claim.id in chosen], matched
 
 
