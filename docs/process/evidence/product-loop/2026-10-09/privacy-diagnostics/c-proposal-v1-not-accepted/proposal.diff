+    assert res.outcome == FetchOutcome.REFUSED_PRIVACY and res.status_code is None
+    assert stats[FetchOutcome.REFUSED_PRIVACY.value] == 1
+    assert res.url == SOURCE and not res.ok
+    absent(marker, payload)
