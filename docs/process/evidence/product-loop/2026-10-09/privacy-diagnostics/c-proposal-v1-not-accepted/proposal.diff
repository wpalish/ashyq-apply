+def test_p2_poisoned_redirect_keeps_safe_requested_identity(tmp_path, monkeypatch, caplog):
+    marker = "SYNTH_P2_TOKEN"
+    hop = "https://public.invalid/jump?token=" + marker
+    resolved, requests = [], []
+
+    def resolve(url):
+        resolved.append(url)
