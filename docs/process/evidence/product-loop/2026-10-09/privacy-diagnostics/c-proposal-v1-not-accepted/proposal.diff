+def captured(caplog):
+    formatter = JsonFormatter()
+    return [
+        {
+            "message": r.getMessage(),
+            "args": repr(r.args),
+            "extra": repr(r.__dict__),
+            "json": formatter.format(r),
+        }
+        for r in caplog.records
+    ]
+
