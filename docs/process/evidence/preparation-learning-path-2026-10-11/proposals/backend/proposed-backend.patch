+def pack_catalogue() -> LearningPackCatalogue:
+    legacy = catalogue()
+    titles = {track.id: track.title for track in legacy.tracks}
+    originals = {lesson.id: lesson for lesson in LESSONS}
+    additions = {lesson.id: lesson for lesson in PACK_LESSONS}
+    summaries = []
+    for ids in TRACK_ORDER.values():
+        for lesson_id in ids:
+            lesson = originals[lesson_id] if lesson_id in originals else additions[lesson_id]
+            summaries.append(
+                LearningPackLessonSummary(
+                    id=lesson.id,
+                    track_id=lesson.track_id,
+                    title=lesson.title,
+                    question_count=len(lesson.items),
+                    version=CONTENT_VERSION if lesson_id in originals else PACK_VERSION,
+                )
+            )
+    return LearningPackCatalogue(
+        version=PACK_VERSION,
+        tracks=[
+            TrackSummary(id=track, title=titles[track], lesson_ids=list(ids))
+            for track, ids in TRACK_ORDER.items()
+        ],
+        lessons=summaries,
+        exams=legacy.exams,
+        notice=legacy.notice
+        + " This opt-in original learning pack adds six five-item lessons. Repeating familiar items is review, not unseen diagnosis; submission is not mastery. Pedagogy and learner validation remain pending.",
