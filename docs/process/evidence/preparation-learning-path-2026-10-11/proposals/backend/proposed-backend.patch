+
+def lesson_dispatch(lesson_id: str, version: str) -> PreparationLesson | LearningPackLesson:
+    if version == CONTENT_VERSION:
+        return public_lesson(get_lesson(lesson_id, version))
+    lesson = get_pack_lesson(lesson_id, version)
+    questions: list[Question | ShortQuestion] = []
+    for item in lesson.items:
+        if isinstance(item, ChoiceItem):
+            questions.append(
+                Question(
+                    id=item.id,
+                    prompt=item.prompt,
+                    choices=[Choice(id=key, text=text) for key, text in item.choices],
+                )
+            )
+        else:
+            questions.append(
+                ShortQuestion(id=item.id, prompt=item.prompt, max_words=item.max_words)
+            )
+    return LearningPackLesson(
+        id=lesson.id,
+        track_id=lesson.track_id,
+        title=lesson.title,
+        version=PACK_VERSION,
+        introduction=lesson.introduction,
+        questions=questions,
+    )
+
+
+def digest_dispatch(payload: StudyAttemptIn | LearningPackStudyAttemptIn) -> str:
+    if all(isinstance(answer, Answer) for answer in payload.answers):
+        # Keep legacy canonical bytes and normalization exactly, including replay.
+        return request_digest(StudyAttemptIn.model_validate(payload.model_dump()))
+    canonical = {
+        "lesson_id": payload.lesson_id,
+        "version": payload.version,
+        "answers": sorted(
+            (answer.model_dump() for answer in payload.answers),
+            key=lambda answer: answer["question_id"],
+        ),
+    }
+    return hashlib.sha256(
+        json.dumps(canonical, sort_keys=True, separators=(",", ":")).encode()
+    ).hexdigest()
+
+
+def normalize_short(text: str) -> str:
+    normalized = " ".join(text.casefold().split())
+    if normalized.endswith("."):
+        normalized = normalized[:-1].rstrip()
+    return normalized
+
+
+def grade_dispatch(
+    payload: StudyAttemptIn | LearningPackStudyAttemptIn,
+) -> tuple[list[dict], list[dict], int]:
+    if payload.version == CONTENT_VERSION:
+        if not all(isinstance(answer, Answer) for answer in payload.answers):
+            raise ValueError("Wrong answer format for question")
+        return grade(StudyAttemptIn.model_validate(payload.model_dump()))
+    lesson = get_pack_lesson(payload.lesson_id, payload.version)
+    answers = {answer.question_id: answer for answer in payload.answers}
+    if len(answers) != len(payload.answers) or set(answers) != {item.id for item in lesson.items}:
+        raise ValueError("Answer every question exactly once")
+    canonical_answers = [answer.model_dump() for answer in payload.answers]
+    feedback: list[dict] = []
+    response: AnswerFeedback | ShortAnswerFeedback
+    for item in lesson.items:
+        selected = answers[item.id]
+        if isinstance(item, ChoiceItem):
+            if not isinstance(selected, Answer):
+                raise ValueError("Wrong answer format for question")
+            if selected.choice_id not in {key for key, _ in item.choices}:
+                raise ValueError("Unknown choice for question")
+            response = AnswerFeedback(
+                question_id=item.id,
+                selected_choice_id=selected.choice_id,
+                correct_choice_id=item.correct_choice_id,
+                correct=selected.choice_id == item.correct_choice_id,
+                explanation=item.explanation,
+            )
+        else:
+            if not isinstance(selected, ShortAnswer):
+                raise ValueError("Wrong answer format for question")
+            normalized = normalize_short(selected.text)
+            accepted = {normalize_short(answer) for answer in item.accepted_answers}
+            response = ShortAnswerFeedback(
+                question_id=item.id,
+                selected_text=selected.text,
+                accepted_answers=list(item.accepted_answers),
+                correct=len(normalized.split()) <= item.max_words and normalized in accepted,
+                explanation=item.explanation,
+            )
+        feedback.append(response.model_dump())
+    return canonical_answers, feedback, sum(bool(item["correct"]) for item in feedback)
+
+
+def completed_lesson_refs(rows: list[tuple[str, str]]) -> list[CompletedLesson]:
+    allowed = {(lesson.id, CONTENT_VERSION) for lesson in LESSONS} | {
+        (lesson.id, PACK_VERSION) for lesson in PACK_LESSONS
+    }
+    known = sorted(set(rows) & allowed)
+    return [CompletedLesson(lesson_id=lesson_id, version=version) for lesson_id, version in known]
