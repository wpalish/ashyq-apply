# Local production-like container stack. Never commit the real values.
POSTGRES_PASSWORD=replace-with-a-long-random-password
UNIMATCH_AUTH_REGISTRATION_ENABLED=true
UNIMATCH_COOKIE_SECURE=false
UNIMATCH_DEMO_MODE=true
UNIMATCH_FETCH_CONTACT=research-contact@example.com

# Payments (Kaspi via ApiPay). Off until a merchant account exists; with
# PAYMENTS_ENABLED false every case is fully open, exactly as before.
UNIMATCH_PAYMENTS_ENABLED=false
UNIMATCH_PAYMENTS_PROVIDER=fake
UNIMATCH_APIPAY_BASE_URL=https://api.apipay.kz/api/v1
UNIMATCH_APIPAY_API_KEY=
UNIMATCH_APIPAY_WEBHOOK_SECRET=
UNIMATCH_CASE_UNLOCK_PRICE_KZT=4990
UNIMATCH_FREE_CANDIDATE_LIMIT=5
UNIMATCH_FREE_SHORTLIST_ROWS=5
