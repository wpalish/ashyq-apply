# UniMatch configuration. Copy to backend/.env and edit.
# No secrets are required — demo mode runs fully offline.

# --- Mode ---------------------------------------------------------------
# true  = bundled synthetic corpus, no network access, deterministic
# false = crawl real university sites (slower, honours robots.txt)
UNIMATCH_DEMO_MODE=true

# --- Politeness (live mode) ---------------------------------------------
# Leave robots on. Turning it off is not supported behaviour.
UNIMATCH_RESPECT_ROBOTS=true
# Minimum seconds between requests to one host; a site's Crawl-delay wins if larger.
UNIMATCH_FETCH_DELAY_SECONDS=1.5
UNIMATCH_FETCH_TIMEOUT_SECONDS=20
UNIMATCH_CACHE_TTL_SECONDS=86400
# Goes into the User-Agent so a site operator can reach a human. Set this
# before crawling anything real.
UNIMATCH_FETCH_CONTACT=

# --- Fetch tiers --------------------------------------------------------
# Playwright rendering for JavaScript-heavy pages. Escalated to only when a
# plain fetch returns a page with no extractable content.
UNIMATCH_ENABLE_BROWSER_TIER=true

# --- Research scope -----------------------------------------------------
UNIMATCH_CANDIDATE_LIMIT=40
UNIMATCH_VERIFY_LIMIT=20
UNIMATCH_ACADEMIC_YEAR=2026/27
UNIMATCH_TARGET_CURRENCY=USD

# --- Storage ------------------------------------------------------------
# SQLite by default. Swap for postgresql+psycopg://user@host/db to migrate;
# the model layer uses no SQLite-only types.
# UNIMATCH_DATABASE_URL=sqlite:///./data/unimatch.db

# --- Server -------------------------------------------------------------
UNIMATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UNIMATCH_LOG_LEVEL=INFO
