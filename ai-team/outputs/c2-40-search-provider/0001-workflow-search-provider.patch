-      UNIMATCH_SEARCH_PROVIDER: ${{ secrets.UNIMATCH_SERPER_API_KEY != '' && 'serper' || (secrets.UNIMATCH_BRAVE_API_KEY != '' && 'brave' || (secrets.UNIMATCH_TAVILY_API_KEY != '' && 'tavily' || (secrets.UNIMATCH_EXA_API_KEY != '' && 'exa' || 'none'))) }}
