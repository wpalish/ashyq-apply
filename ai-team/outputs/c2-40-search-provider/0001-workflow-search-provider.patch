@@ -94,21 +103,47 @@ jobs:
       - run: python -m venv .venv
       - run: .venv/bin/pip install -r requirements-dev.txt
 
+      - name: Select the search layer
+        env:
+          REQUESTED_SEARCH_PROVIDER: ${{ inputs.search_provider || 'auto' }}
+        run: |
+          set -euo pipefail
+          requested="$REQUESTED_SEARCH_PROVIDER"
+          decided_by="explicit input"
+          case "$requested" in
+            auto)
+              if [ -n "$UNIMATCH_SERPER_API_KEY" ]; then
+                provider=serper; decided_by=UNIMATCH_SERPER_API_KEY
+              elif [ -n "$UNIMATCH_BRAVE_API_KEY" ]; then
+                provider=brave; decided_by=UNIMATCH_BRAVE_API_KEY
+              elif [ -n "$UNIMATCH_TAVILY_API_KEY" ]; then
+                provider=tavily; decided_by=UNIMATCH_TAVILY_API_KEY
+              elif [ -n "$UNIMATCH_EXA_API_KEY" ]; then
+                provider=exa; decided_by=UNIMATCH_EXA_API_KEY
+              else
+                provider=none; decided_by="no configured search key"
+              fi
+              ;;
+            exa)
+              if [ -z "$UNIMATCH_EXA_API_KEY" ]; then
+                echo "::error::exa requires UNIMATCH_EXA_API_KEY; no capture started"
+                exit 1
+              fi
+              provider=exa; decided_by="explicit input and UNIMATCH_EXA_API_KEY"
+              ;;
+            exa_mcp|none) provider="$requested" ;;
+            *) echo "::error::unknown search_provider; no capture started"; exit 1 ;;
+          esac
+          echo "UNIMATCH_SEARCH_PROVIDER=$provider" >> "$GITHUB_ENV"
+          echo "search provider: $provider (decided by $decided_by)"
+          mkdir -p out
+          echo "provider=$provider" > out/config.txt
+          echo "decided_by=$decided_by" >> out/config.txt
