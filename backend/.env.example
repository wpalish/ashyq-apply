# Backend environment. Copy to backend/.env for local development.
#
#   cp .env.example .env
#
# backend/.env is already covered by .gitignore. Every name is prefixed
# UNIMATCH_ because Settings uses env_prefix="UNIMATCH_" (app/config.py);
# a name without the prefix is silently ignored.

# ---------------------------------------------------------------- core
UNIMATCH_ENVIRONMENT=development
UNIMATCH_DEMO_MODE=true
UNIMATCH_AUTH_ENABLED=false        # true for anything but a local demo
UNIMATCH_COOKIE_SECURE=false       # true in production, always
# UNIMATCH_DATABASE_URL=postgresql+psycopg://ashyq:password@localhost:5432/ashyq_apply

# ---------------------------------------------------------------- accounts
# Password reset links are built from this origin; HTTPS in production.
UNIMATCH_PUBLIC_BASE_URL=http://127.0.0.1:5173
# Past this many live sessions the oldest is revoked rather than kept for years.
UNIMATCH_MAX_SESSIONS_PER_USER=20
UNIMATCH_PASSWORD_RESET_TTL_MINUTES=60
# scrypt cost as a power of two. 17 is the production value (~1s per hash);
# the test suite lowers it, and older 2**14 hashes still verify.
UNIMATCH_PASSWORD_SCRYPT_LOG2=17
# "console" only logs the reset link, which is why production refuses it.
UNIMATCH_EMAIL_SENDER=console
UNIMATCH_SMTP_HOST=
UNIMATCH_SMTP_PORT=587
UNIMATCH_SMTP_USERNAME=
UNIMATCH_SMTP_PASSWORD=
UNIMATCH_SMTP_FROM=no-reply@ashyq.example
# Recorded on the user but not enforced: there is no verification flow yet.
UNIMATCH_AUTH_REQUIRE_VERIFIED_EMAIL=false

# ---------------------------------------------------------------- deployment
# Believe X-Forwarded-For only behind a proxy we control (nginx, Fly's edge).
UNIMATCH_TRUST_PROXY_HEADERS=false
UNIMATCH_JOB_LEASE_SECONDS=120
UNIMATCH_LOG_LEVEL=INFO
