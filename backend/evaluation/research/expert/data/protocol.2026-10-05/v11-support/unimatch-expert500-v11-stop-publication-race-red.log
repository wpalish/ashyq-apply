        old_command = peer.command
        observed_cascade = []
    
        def peer_command(argv, **kwargs):
            if argv[:3] == ["gh", "run", "view"]:
                peer.calls.append({"argv": argv, "at": peer.clock.seconds, "timeout": kwargs["timeout"]})
                if not observed_cascade:
                    peer_waiting.set()
                    assert origin_receipt_waiting.wait(timeout=10)
                    observed_cascade.append(shared.is_set())
                pending = observed_cascade[0] and not peer.cancelled
                return json.dumps({
                    "status": "in_progress" if pending else "completed",
