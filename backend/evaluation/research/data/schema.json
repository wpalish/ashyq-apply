{
  "$defs": {
    "Case": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "dataset_version": {
          "title": "Dataset Version",
          "type": "string"
        },
        "university": {
          "title": "University",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "country": {
          "title": "Country",
          "type": "string"
        },
        "site_types": {
          "items": {
            "type": "string"
          },
          "title": "Site Types",
          "type": "array"
        },
        "request": {
          "$ref": "#/$defs/Scope"
        },
        "programme_urls": {
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Programme Urls",
          "type": "array"
        },
        "programme_status": {
          "default": "unknown",
          "enum": [
            "known",
            "unknown",
            "absent"
          ],
          "title": "Programme Status",
          "type": "string"
        },
        "programme_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Programme Evidence",
          "type": "array"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/Label"
          },
          "title": "Labels",
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/Review"
        }
      },
      "required": [
        "id",
        "dataset_version",
        "university",
        "domain",
        "country",
        "site_types",
        "request",
        "labels",
        "review"
      ],
      "title": "Case",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "accessed_on": {
          "format": "date",
          "title": "Accessed On",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "official",
            "government",
            "aggregator",
            "unknown"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "excerpt_truncated": {
          "default": false,
          "title": "Excerpt Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "excerpt",
        "scope",
        "accessed_on",
        "source_type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "JsonValue": {},
    "Label": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "status": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "critical": {
          "default": true,
          "title": "Critical",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "key",
        "status"
      ],
      "title": "Label",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "human_verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "prepared_by": {
          "minLength": 1,
          "title": "Prepared By",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "verified_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified On"
        },
        "notes": {
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "prepared_by",
        "notes"
      ],
      "title": "Review",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "university": {
          "title": "University",
          "type": "string"
        },
        "programme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Programme"
        },
        "degree": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degree"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "intake": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intake"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "qualification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualification"
        },
        "academic_year": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Academic Year"
        }
      },
      "required": [
        "university"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "validation"
      ],
      "title": "Split",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/Case"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "version",
    "split",
    "cases"
  ],
  "title": "Dataset",
  "type": "object"
}
